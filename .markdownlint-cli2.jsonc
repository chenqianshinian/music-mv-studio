{
  // 这是一份中文技术文档仓库。默认规则里有几条对中文写作是纯噪音，按需求关掉：
  "config": {
    "MD013": false, // 行长度：中文按语义断行，不按 80 列
    "MD024": false, // 重复标题：CHANGELOG 每个版本都会有同名小节
    "MD033": false, // 内联 HTML：表格里确实需要 <br>
    "MD034": false, // 裸 URL：示例与引用里会出现
    "MD036": false, // 用强调代替标题：文档里用**加粗**做强调是刻意的
    "MD040": false, // 代码块语言：数据流示意图不是任何语言
    "MD041": false  // 首行必须是 h1：SKILL.md 以 YAML frontmatter 开头
  }
}
