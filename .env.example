# 复制成 .env 后填自己的值。.env 已在 .gitignore 里，不会被提交。
# 所有变量由 scripts/_mvcfg.py 统一读取：进程环境变量 > .env > 代码里的安全默认值。
#
# ⚠️ 注释请**独占一行**，不要写在值的后面（`MV_KF_MODEL=xxx  # 首帧` 这种写法虽然现在
#    解析器会剥掉注释，但老版本不会——v3.0 照抄本模板会把 " # 首帧" 一起当成模型名发出去）。

# ── 接口（任何兼容 OpenAI 风格的图像/视频/视觉服务都可以）──────────────────
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.cn

# 模型名（换成你账号里可用的即可；换供应商改这里，不用改代码）
# 首帧图像
MV_KF_MODEL=agnes-image-2.1-flash
# 第二关键帧（i2i 派生）
MV_I2I_MODEL=agnes-image-2.1-flash
# 图生视频
MV_I2V_MODEL=agnes-video-v2.0
# 视觉复核（质检、数人头、判画风）
MV_VISION_MODEL=agnes-3.0-flash

# ── 工具与目录 ─────────────────────────────────────────────────────────────
# 留空则 ffmpeg/ffprobe/curl 走 PATH；填绝对路径可指定某一版
FFMPEG_BIN=
FFPROBE_BIN=
CURL_BIN=

# 中间产物目录（逐镜抽帧缓存会有几 GB，放数据盘，不要放系统盘）
MV_WORK=
MV_TMP=

# 字体：必须 OFL 等可商用授权。注意——不要把字体文件提交进仓库或跨机器拷贝。
# 留空时脚本会跨平台自动探测系统 CJK 字体（macOS 苹方 / Windows 雅黑 / Linux Noto），
# 只够自检与预览；正式出片请显式指向自己的 OFL 字体。
MV_FONT_BRUSH=
MV_FONT_UI=

# ── 生成器上传垫图（scripts/gen_zuindongni.py）─────────────────────────────
# i2v/i2i 接口只吃 URL，垫图必须先传到图床。
# 默认是一家匿名公共图床：含人脸的关键帧会变成公开可访问的 URL。介意就换成自己的图床
# （需要兼容 `curl -F <字段>=@文件 <URL>` 并返回 {"files":[{"url":...}]}）。
MV_UPLOAD_URL=https://uguu.se/upload
MV_UPLOAD_FIELD=files[]
# 设为 1 时禁止上传（离线自检用）
MV_UPLOAD_DISABLE=

# ── 合成器（scripts/compose_mv.py）─────────────────────────────────────────
ZDN_BANK=
ZDN_CLIPS=
ZDN_OUT=
ZDN_SRT=
ZDN_AUDIO=
ZDN_TOTAL=
ZDN_LEAD=0.65
ZDN_DISSOLVE=0.65
# 结尾淡出，格式"起秒,时长"；留空则不淡出
ZDN_FADE_OUT=
# 逐句揭示时间表（可选）／字幕颜色锚点（可选）
ZDN_CLAUSES=
ZDN_CAPTION_COLORS=
